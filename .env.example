# STREAMIX secure video brique — see ../STREAMIX/README.md and
# "STREAMIX réseau explication.pdf" for how these are used.

# HLS playlist served by the STREAMIX nginx container (docker compose up -d in ../STREAMIX)
VITE_STREAMIX_HLS_URL=https://localhost:8443/hls/video.m3u8

# STREAMIX key-server: real user login, issues a session token
VITE_STREAMIX_AUTH_LOGIN_URL=https://localhost:3001/auth/login

# STREAMIX key-server: exchanges a valid session token for a temporary HLS key token
VITE_STREAMIX_TOKEN_URL=https://localhost:3001/token
